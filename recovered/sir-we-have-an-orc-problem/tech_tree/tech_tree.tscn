[sub_resource type="Shader" id="Shader_f1ask"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.6.2.rc's CanvasItemMaterial.

shader_type canvas_item;
render_mode blend_mix;

float random (vec2 uv) {
    return fract(sin(dot(uv.xy,
        vec2(12.9898,78.233))) * 43758.5453123);
}

uniform float WAVE_SPEED : hint_range(0.01, 10.0) = 1.0;
uniform float WAVE_FREQ : hint_range(0.01, 10.0) = 4.0;
uniform float WAVE_AMPL : hint_range(0.01, 0.1) = 0.05;
uniform float NOISE_SCALE = 1.0;


void fragment() {
	vec2 uv = UV;
	vec2 tex_size = vec2(textureSize(TEXTURE, 0));
	vec2 noise_scale = (1.0 / tex_size) * NOISE_SCALE;
	uv.y += sin(TIME * WAVE_SPEED + UV.x * WAVE_FREQ) * WAVE_AMPL;
	uv.y += sin(TIME * WAVE_SPEED + UV.x * WAVE_FREQ * 3.0) * WAVE_AMPL * 0.5;
	uv.y += sin(TIME * WAVE_SPEED + UV.x * WAVE_FREQ * 10.0) * WAVE_AMPL * 0.25;
	uv += noise_scale * random(UV);
	COLOR = texture(TEXTURE, uv);
}"

